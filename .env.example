# 32자 이상 임의 문자열 (iron-session 쿠키 암호화)
SESSION_PASSWORD=

# Supabase Postgres 연결 문자열 — 대시보드 상단 [Connect] > Session pooler (포트 5432)
# [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣는다. 비워두면 로컬 PGlite(data/pglite)를 사용.
DATABASE_URL=

# Supabase Storage (프로필 사진). 서버에서만 사용 — NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# Project Settings > API Keys 의 secret 키(sb_secret_...). 비워두면 data/uploads 에 저장.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 아래 값은 이 앱에서 쓰지 않는다 (브라우저에서 Supabase를 직접 쓰지 않고, Supabase Auth도 쓰지 않음).
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_JWKS_URL=
